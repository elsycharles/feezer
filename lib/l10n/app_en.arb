  "faqQuestion1": "How do I minimize transaction fees?",
  "@faqQuestion1": {
    "description": "First FAQ question"
  },
  "faqAnswer1": "Our app automatically calculates the most cost-effective way to handle your transactions by comparing different providers and payment methods.",
  "@faqAnswer1": {
    "description": "First FAQ answer"
  },
  "faqQuestion2": "What currencies are supported?",
  "@faqQuestion2": {
    "description": "Second FAQ question"
  },
  "faqAnswer2": "We support all major world currencies including USD, EUR, GBP, JPY, and many others. The app automatically handles currency conversion rates.",
  "@faqAnswer2": {
    "description": "Second FAQ answer"
  },
  "faqQuestion3": "Is my financial data secure?",
  "@faqQuestion3": {
    "description": "Third FAQ question"
  },
  "faqAnswer3": "Yes, we use bank-level encryption and security measures. Your data is never stored on our servers and all calculations are done locally on your device.",
  "@faqAnswer3": {
    "description": "Third FAQ answer"
  },
  "faqQuestion4": "How do I update currency rates?",
  "@faqQuestion4": {
    "description": "Fourth FAQ question"
  },
  "faqAnswer4": "Currency rates are automatically updated in real-time from reliable financial data providers. You can also manually refresh rates in the settings.",
  "@faqAnswer4": {
    "description": "Fourth FAQ answer"
  },
  "faqQuestion5": "Can I save my favorite providers?",
  "@faqQuestion5": {
    "description": "Fifth FAQ question"
  },
  "faqAnswer5": "Yes, you can save your preferred banking providers and payment methods for quick access when making new calculations.",
  "@faqAnswer5": {
    "description": "Fifth FAQ answer"
  },
  "faqQuestion6": "How do I add a new provider?",
  "@faqQuestion6": {
    "description": "Sixth FAQ question"
  },
  "faqAnswer6": "Tap the '+' button in the provider list screen. Enter the provider name, description, and choose an icon. You can then add fee intervals for different transaction amounts.",
  "@faqAnswer6": {
    "description": "Sixth FAQ answer"
  },
  "faqQuestion7": "What are fee intervals?",
  "@faqQuestion7": {
    "description": "Seventh FAQ question"
  },
  "faqAnswer7": "Fee intervals define the cost structure for each provider. You can set fixed fees (e.g., $2.50) or percentage fees (e.g., 1.5%) for different transaction amount ranges.",
  "@faqAnswer7": {
    "description": "Seventh FAQ answer"
  },
  "faqQuestion8": "How does the optimization work?",
  "@faqQuestion8": {
    "description": "Eighth FAQ question"
  },
  "faqAnswer8": "Feezer analyzes all your providers' fee structures and calculates the optimal way to split your transaction into multiple operations to minimize total fees while respecting your constraints.",
  "@faqAnswer8": {
    "description": "Eighth FAQ answer"
  }

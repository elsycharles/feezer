  "faqHowToAddProvider": "How do I add a grid?",
  "@faqHowToAddProvider": {
    "description": "FAQ question"
  },
  "faqHowToAddProviderAnswer": "In the Operators tab, tap \"Add\", enter the operator name and the operation, then add the tiers (minimum, maximum and fee). You can also import a CSV file.",
  "@faqHowToAddProviderAnswer": {
    "description": "FAQ answer"
  },
  "faqHowToCalculateFees": "How is it calculated?",
  "@faqHowToCalculateFees": {
    "description": "FAQ question"
  },
  "faqHowToCalculateFeesAnswer": "Choose the operator and the operation, then enter the amount available (fees included). Feezer tries every combination of tiers and keeps the one that delivers the most. The result is compared with the usual way: withdrawing or sending the largest possible amount each time.",
  "@faqHowToCalculateFeesAnswer": {
    "description": "FAQ answer"
  },
  "faqMinMaxTransactionRange": "What is the number of transactions for?",
  "@faqMinMaxTransactionRange": {
    "description": "FAQ question: meaning of min/max number of transactions"
  },
  "faqMinMaxTransactionRangeAnswer": "It is optional. It limits how many withdrawals or transfers the split may use, for example \"at most 2\" if you do not want more than two. Feezer shows what the limit costs you.",
  "@faqMinMaxTransactionRangeAnswer": {
    "description": "FAQ answer: meaning of min/max number of transactions"
  },
  "faqDataSecurity": "Is my data shared?",
  "@faqDataSecurity": {
    "description": "FAQ question"
  },
  "faqDataSecurityAnswer": "No. Your grids and amounts stay on your phone; Feezer has no account and sends nothing. Updating the fees only downloads a public file.",

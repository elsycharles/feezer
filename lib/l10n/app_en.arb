  "faqWhatIsFeeMinimizer": "What is Feezer or Fee Minimizer?",
  "@faqWhatIsFeeMinimizer": {
    "description": "FAQ question"
  },
  "faqWhatIsFeeMinimizerAnswer": "Feezer or Fee Minimizer is a mobile application that helps users calculate and optimize transaction fees across different financial providers. It analyzes your transaction details and suggests the most cost-effective options to minimize banking fees.",
  "@faqWhatIsFeeMinimizerAnswer": {
    "description": "FAQ answer"
  },
  "faqHowToAddProvider": "How do I add a new provider?",
  "@faqHowToAddProvider": {
    "description": "FAQ question"
  },
  "faqHowToAddProviderAnswer": "To add a new provider, go to the Providers screen and tap the '+' button. Fill in the provider details including name, description, and fee structure. You can also import provider data using CSV files. There are no favorite providers - you have full control to add and remove providers as needed.",
  "@faqHowToAddProviderAnswer": {
    "description": "FAQ answer"
  },
  "faqHowToCalculateFees": "How does fee calculation work?",
  "@faqHowToCalculateFees": {
    "description": "FAQ question"
  },
  "faqHowToCalculateFeesAnswer": "Enter your transaction amount and select a provider. The app will calculate all applicable fees including fixed fees, percentage fees, and minimum/maximum fees. It then shows you the total cost and suggests optimizations.",
  "@faqHowToCalculateFeesAnswer": {
    "description": "FAQ answer"
  },
  "faqDataSecurity": "Is my data secure?",
  "@faqDataSecurity": {
    "description": "FAQ question"
  },
  "faqDataSecurityAnswer": "Your financial data is stored locally on your device without encryption or additional security measures. This app does not provide banking-level security features. All data remains on your device and is not transmitted anywhere.",
  "@faqDataSecurityAnswer": {
    "description": "FAQ answer"
  },
  "faqOfflineMode": "Does the app work offline?",
  "@faqOfflineMode": {
    "description": "FAQ question"
  },
  "faqOfflineModeAnswer": "Yes, Feezer or Fee Minimizer works completely offline. All your data and calculations are stored locally on your device. You can use all features without an internet connection.",
  "@faqOfflineModeAnswer": {
    "description": "FAQ answer"
  },
  "faqCurrencyRates": "How do currency exchange rates work?",
  "@faqCurrencyRates": {
    "description": "FAQ question"
  },
  "faqCurrencyRatesAnswer": "The app does not automatically update currency exchange rates. You have full control and can manually set your own exchange rates for complete customization. This gives you total flexibility to use rates that suit your needs, and works perfectly offline.",
